{
  "name": "@jalexsocial/rizzyui",
  "version": "1.0.0-preview.4-dev",
  "description": "Client library for Asp.net RizzyUI",
  "main": "dist/js/rizzyui.js",
  "module": "dist/js/rizzyui.js",
  "exports": {
    ".": {
      "types": "./types/rizzyui.d.ts",
      "import": "./dist/js/rizzyui.js",
      "default": "./dist/js/rizzyui.js"
    },
    "./csp": {
      "types": "./types/rizzyui.d.ts",
      "import": "./dist/js/rizzyui-csp.js",
      "default": "./dist/js/rizzyui-csp.js"
    },
    "./antiforgerySnippet": "./dist/js/antiforgerySnippet.js",
    "./antiforgerySnippet.js": "./dist/js/antiforgerySnippet.js",
    "./antiforgerySnippet.min.js": "./dist/js/antiforgerySnippet.min.js",
    "./testing": {
      "types": "./types/testing.d.ts",
      "import": "./testing/index.js",
      "default": "./testing/index.js"
    },
    "./types": "./types/rizzyui.d.ts",
    "./types/rizzyui.d.ts": "./types/rizzyui.d.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "types": "types/rizzyui.d.ts",
  "files": [
    "dist",
    "types",
    "testing",
    "src/js/package.json",
    "src/js/lib/alpineProps.js",
    "src/js/lib/codeBehindLifecycle.js"
  ],
  "scripts": {
    "test": "node --test \"src/js/**/*.test.mjs\" \"tests/**/*.test.mjs\"",
    "build": "node ./build/build-all.mjs",
    "build:clean": "node ./build/clean-generated.mjs",
    "build:js": "node ./build/build-js.mjs",
    "build:assets": "node ./build/build-assets.mjs",
    "build:antiforgery": "node ./build/build-antiforgery.mjs",
    "build:highlightjs": "node ./build/build-highlightjs.mjs",
    "build:css": "node ./build/build-css.mjs",
    "build:safelist": "node ./build/parse-tailwind-css.js",
    "build:copy": "node ./build/copy-dist.mjs",
    "dev": "vite",
    "preview": "vite preview --outDir dist",
    "analyze": "vite build",
    "clean": "node ./build/clean-generated.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JalexSocial/RizzyUI.git"
  },
  "keywords": [
    "asp.net",
    "blazor",
    "tailwind",
    "ssr",
    "htmx",
    "rizzy"
  ],
  "author": "Michael Tanczos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JalexSocial/RizzyUI/issues"
  },
  "homepage": "https://github.com/JalexSocial/RizzyUI#readme",
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.11",
    "@tailwindcss/cli": "^4.2.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.0.11",
    "highlight.js": "11.10.0",
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^7.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.15.8",
    "@alpinejs/csp": "^3.15.8",
    "@alpinejs/focus": "^3.15.8",
    "@alpinejs/intersect": "^3.15.8",
    "@floating-ui/dom": "^1.7.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/table-core": "^8.21.3",
    "alpinejs": "^3.15.8",
    "aspnet-client-validation": "^0.11.1",
    "async-alpine": "^2.0.3",
    "canvas-confetti": "^1.9.3",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "htmx.org": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "htmx.org": {
      "optional": true
    }
  }
}
