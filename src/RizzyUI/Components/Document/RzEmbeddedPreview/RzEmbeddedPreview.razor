@namespace RizzyUI
@inherits RzComponent<RzEmbeddedPreview.Slots>

@* The Alpine component is on the wrapper, not the <iframe>: the CSP build of Alpine refuses to
   evaluate expressions on an iframe element, so x-data on the iframe threw under rizzyui-csp.js. *@
<HtmlElement Element="@EffectiveElement"
             data-slot="embedded-preview"
             @attributes="@AdditionalAttributes"
             id="@Id"
             class="@SlotClasses.GetBase()"
             x-data="rzEmbeddedPreview"
             x-load="@LoadStrategyOrNull"
             data-alpine-root="@Id">
	<iframe class="@SlotClasses.GetIFrame()"
	        srcdoc="@_content"
	        x-ref="iframe"
	        title="@EffectiveIFrameTitle">
	</iframe>
</HtmlElement>
