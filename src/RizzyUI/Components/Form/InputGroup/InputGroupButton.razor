
@namespace RizzyUI
@inherits RzComponent<InputGroupButtonSlots>

<RzButton data-slot="input-group-button" @attributes="AdditionalAttributes"
          Id="@Id"
          Variant="@Variant"
          Outline=@Outline
          class="@SlotClasses.GetBase()"
          data-size="@Size.ToString().ToLowerInvariant()">
    @ChildContent
</RzButton>