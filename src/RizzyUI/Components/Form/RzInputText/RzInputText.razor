
@namespace RizzyUI
@using Rizzy
@inherits InputBase<string, RzInputText.Slots>

<RzInputTextBase type="@Role.ToString().ToLowerInvariant()" data-slot="@RzInputText.SlotNames.NameOf(SlotTypes.Base)" @attributes="InputAttributes"
    @ref="_elem"
    ValueExpression="@For"
    Value="@Value"
    DisplayName="@DisplayName"
    placeholder="@Placeholder"
    class="@SlotClasses.GetBase()"
    id="@Id"
/>