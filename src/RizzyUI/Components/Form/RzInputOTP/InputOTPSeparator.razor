@namespace RizzyUI
@using Blazicons
@inherits RzComponent<InputOTPSeparator.Slots>

<HtmlElement Element="@EffectiveElement"
             id="@Id"
             data-slot="input-otp-separator" role="separator" @attributes="@AdditionalAttributes"
             class="@GetSeparatorClasses()">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <Blazicon Svg="Lucide.Minus" class="@SlotClasses.GetIcon()" data-slot="@InputOTPSeparator.SlotNames.NameOf(SlotTypes.Icon)" aria-hidden="true" />
    }
</HtmlElement>
