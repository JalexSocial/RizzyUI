
@typeparam TValue
@namespace RizzyUI
@inherits RzComponent<RzCheckboxGroupSlots>

<HtmlElement Element="@EffectiveElement" 
             data-slot="@RzCheckboxGroupSlotNames.NameOf(RzCheckboxGroupSlotTypes.Base)" role="group" @attributes="AdditionalAttributes" 
             id="@Id" 
             class="@SlotClasses.GetBase()"
             aria-labelledby="@LegendId">
    <legend id="@LegendId" class="sr-only">@DisplayName</legend>
    <CascadingValue Value="this" IsFixed="true">
        <CascadingValue Value="ShowIndicators" Name="ShowIndicators">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
</HtmlElement>