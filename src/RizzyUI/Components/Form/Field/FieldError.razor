
@namespace RizzyUI
@inherits RzComponent<FieldError.Slots>

@if (Content is not null)
{
    <HtmlElement Element="@EffectiveElement" role="alert" data-slot="field-error" @attributes="AdditionalAttributes" 
                 id="@Id" 
                 class="@SlotClasses.GetBase()">
        @Content
    </HtmlElement>
}