
@namespace RizzyUI
@using Blazicons
@inherits RzComponent<RzDateEdit.Slots>

<HtmlElement Element="div" data-slot="date-edit"
             role="group" @attributes="AdditionalAttributes"
             id="@Id"
             class="@SlotClasses.GetBase()" aria-label="Date picker">
	
	<div x-data="rzDateEdit" x-load="@LoadStrategyOrNull"
	     data-alpine-root="@Id"
	     data-config="@_serializedConfig"
	     data-uid="@DateUid"
	     data-input-id="@_inputId"
	     data-assets="@_assets"
	     data-nonce="@Nonce">

		<div class="@SlotClasses.GetInputWrapper()" x-data="rzPrependInput" x-load="@LoadStrategyOrNull" x-ref="pickerWrapper">
			@if (!string.IsNullOrEmpty(PrependText) || PrependIcon != null)
			{
				<div x-ref="prependContainer" class="@SlotClasses.GetPrependElement()">
					@if (!string.IsNullOrEmpty(PrependText))
					{
						@PrependText
					}
					else if (PrependIcon != null)
					{
						<div class="@SlotClasses.GetPrependIconContainer()">
							<Blazicon Svg="PrependIcon"/>
						</div>
					}
				</div>
			}

			@RenderInput()
		</div>
	</div>	
</HtmlElement>