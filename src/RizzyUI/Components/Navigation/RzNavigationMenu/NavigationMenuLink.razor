
@namespace RizzyUI
@inherits RzAsChildComponent<NavigationMenuLink.Slots>

@if (AsChild)
{
	@RenderAsChild()
}
else
{
	<HtmlElement Element="@EffectiveElement" data-slot="navigation-menu-link" @attributes="@AdditionalAttributes"
	             id="@Id"
	             class="@SlotClasses.GetBase()"
	             href="@Href">
		@ChildContent
	</HtmlElement>	
}