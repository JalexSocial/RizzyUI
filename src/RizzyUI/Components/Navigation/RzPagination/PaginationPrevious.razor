@namespace RizzyUI
@using Blazicons
@inherits RzComponent<PaginationPrevious.Slots>

<HtmlElement Element="@EffectiveElement" data-slot="@PaginationPrevious.SlotNames.NameOf(SlotTypes.Base)" @attributes="@AdditionalAttributes"
             id="@Id"
             href="@Href"
             class="@SlotClasses.GetBase()"
             aria-label="@EffectiveAriaLabel">
    <Blazicon Svg="Lucide.ChevronLeft" class="@SlotClasses.GetIcon()" data-slot="@PaginationPrevious.SlotNames.NameOf(SlotTypes.Icon)" aria-hidden="true" />
    <span class="@SlotClasses.GetLabel()" data-slot="@PaginationPrevious.SlotNames.NameOf(SlotTypes.Label)">@EffectiveLabel</span>
</HtmlElement>
