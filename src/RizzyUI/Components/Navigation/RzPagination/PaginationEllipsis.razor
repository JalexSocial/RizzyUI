@namespace RizzyUI
@using Blazicons
@inherits RzComponent<PaginationEllipsis.Slots>

<HtmlElement Element="@EffectiveElement"
             id="@Id"
             data-slot="@PaginationEllipsis.SlotNames.NameOf(SlotTypes.Base)" @attributes="@AdditionalAttributes"
             class="@SlotClasses.GetBase()"
             aria-hidden="true">
    <Blazicon Svg="Lucide.Ellipsis" class="@SlotClasses.GetIcon()" data-slot="@PaginationEllipsis.SlotNames.NameOf(SlotTypes.Icon)" aria-hidden="true" />
    <span class="@SlotClasses.GetSrOnly()" data-slot="@PaginationEllipsis.SlotNames.NameOf(SlotTypes.SrOnly)">@EffectiveScreenReaderText</span>
</HtmlElement>
