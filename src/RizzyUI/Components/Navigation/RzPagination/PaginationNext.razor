@namespace RizzyUI
@using Blazicons
@inherits RzComponent<PaginationNext.Slots>

<HtmlElement Element="@EffectiveElement" data-slot="@PaginationNext.SlotNames.NameOf(SlotTypes.Base)" @attributes="@AdditionalAttributes"
             id="@Id"
             href="@Href"
             class="@SlotClasses.GetBase()"
             aria-label="@EffectiveAriaLabel">
    <span class="@SlotClasses.GetLabel()" data-slot="@PaginationNext.SlotNames.NameOf(SlotTypes.Label)">@EffectiveLabel</span>
    <Blazicon Svg="Lucide.ChevronRight" class="@SlotClasses.GetIcon()" data-slot="@PaginationNext.SlotNames.NameOf(SlotTypes.Icon)" aria-hidden="true" />
</HtmlElement>
