@namespace RizzyUI
@inherits RzComponent<PaginationLink.Slots>

<HtmlElement Element="@EffectiveElement" data-slot="@PaginationLink.SlotNames.NameOf(SlotTypes.Base)" @attributes="@AdditionalAttributes"
             id="@Id"
             href="@Href"
             class="@SlotClasses.GetBase()"
             aria-label="@AriaLabel"
             aria-current="@(IsActive ? "page" : null)">
    @ChildContent
</HtmlElement>
