
@namespace RizzyUI
@using Blazicons
@inherits RzComponent<SidebarTrigger.Slots>

<HtmlElement Element="@EffectiveElement"
             type="button"
             data-slot="sidebar-trigger" @attributes="@AdditionalAttributes"
             id="@Id"
             class="@SlotClasses.GetBase()"
             aria-label="@EffectiveAriaLabel"
             x-on:click="toggle"
             aria-controls="@ParentProvider?.Id"
             x-bind:aria-expanded="triggerExpanded"
             data-sidebar="trigger">
	@if (ChildContent == null)
	{
		<Blazicon Svg="@Lucide.PanelLeft"/>
	}
	else
	{
		@ChildContent
	}
</HtmlElement>