
@namespace RizzyUI
@using Blazicons
@inherits RzComponent<BreadcrumbSeparator.Slots>

<HtmlElement Element="@EffectiveElement" role="presentation" data-slot="breadcrumb-separator" @attributes="@AdditionalAttributes"
             aria-hidden="true"
             id="@Id"
             class="@SlotClasses.GetBase()">
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else
    {
        <Blazicon Svg="Lucide.ChevronRight" class="@SlotClasses.GetIcon()" />
    }
</HtmlElement>