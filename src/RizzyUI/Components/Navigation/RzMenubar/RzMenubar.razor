@namespace RizzyUI
@inherits RzComponent<RzMenubar.Slots>

<CascadingValue Value="this" IsFixed="true">
    <HtmlElement Element="@EffectiveElement"
                 id="@Id"
                 role="menubar" data-slot="menubar" @attributes="@AdditionalAttributes"
                 class="@SlotClasses.GetBase()"
                 x-data="rzMenubar" x-load="@LoadStrategyOrNull"
                 data-alpine-root="@Id">
        @ChildContent
    </HtmlElement>
</CascadingValue>
