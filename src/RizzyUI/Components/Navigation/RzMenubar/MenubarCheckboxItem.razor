@namespace RizzyUI
@using Blazicons
@inherits RzComponent<MenubarCheckboxItem.Slots>

<HtmlElement Element="@EffectiveElement"
             id="@Id"
             role="menuitemcheckbox" data-slot="menubar-checkbox-item" @attributes="@AdditionalAttributes"
             class="@SlotClasses.GetBase()"
             tabindex="-1"
             aria-checked="@(Checked.ToString().ToLowerInvariant())"
             data-state="@(Checked ? "checked" : "unchecked")"
             data-value="@Value"
             x-on:click="toggleCheckboxItem"
             x-on:mouseenter="handleItemMouseEnter"
             x-on:mouseleave="handleItemMouseLeave">
    <span class="@SlotClasses.GetIndicator()" data-slot="menubar-item-indicator">
        <Blazicon Svg="Lucide.Check" aria-hidden="true" />
    </span>
    @ChildContent
    @if (ShortcutContent is not null)
    {
        @ShortcutContent
    }
</HtmlElement>
