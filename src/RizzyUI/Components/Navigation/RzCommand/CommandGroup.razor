
@namespace RizzyUI
@inherits RzComponent<CommandGroup.Slots>

<CascadingValue Value="this" IsFixed="true">
    <div data-slot="command-group" @attributes="AdditionalAttributes"
         id="@Id"
         x-data="rzCommandGroup" x-load="@LoadStrategyOrNull"
         data-alpine-root="@Id"
         data-heading="@Heading"
         data-template-id="@HeadingTemplateId">
        <template id="@HeadingTemplateId" data-heading-id="@HeadingId">
            <div class="@SlotClasses.GetHeading()" id="@HeadingId" data-slot="command-group-heading">@Heading</div>
        </template>
        @ChildContent
    </div>
</CascadingValue>
