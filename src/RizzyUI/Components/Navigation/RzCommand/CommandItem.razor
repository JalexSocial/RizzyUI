
@namespace RizzyUI
@inherits RzComponent<CommandItem.Slots>

<div id="@Id"
     x-data="rzCommandItem" x-load="@LoadStrategyOrNull"
     data-alpine-root="@Id"
     data-value="@Value"
     data-name="@Name"
     data-href="@Href"
     data-keywords="@_serializedKeywords"
     data-group="@ParentGroup?.Heading"
     data-disabled="@(Disabled.ToString().ToLowerInvariant())"
     data-force-mount="@(ForceMount.ToString().ToLowerInvariant())">
    <template x-ref="template" id="@($"{Id}-template")">
        <div data-slot="command-item" @attributes="AdditionalAttributes" class="@SlotClasses.GetBase()" aria-disabled="@(Disabled.ToString().ToLowerInvariant())" data-command-item-id="@Id">
            @ChildContent
        </div>
    </template>
</div>
