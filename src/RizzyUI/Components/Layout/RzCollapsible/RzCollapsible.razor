@namespace RizzyUI
@inherits RzAsChildComponent<RzCollapsible.Slots>

<CascadingValue Value="this" IsFixed="true">
    @if (AsChild)
    {
        @RenderAsChild()
    }
    else
    {
        <HtmlElement Element="@EffectiveElement" @attributes="GetComponentAttributes()">
            @ChildContent
        </HtmlElement>
    }
</CascadingValue>
