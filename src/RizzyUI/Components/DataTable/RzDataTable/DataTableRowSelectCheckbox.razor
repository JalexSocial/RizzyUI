@namespace RizzyUI
@inherits RzComponent<DataTableRowSelectCheckbox.Slots>

<HtmlElement Element="@EffectiveElement"
             id="@Id"
             data-slot="data-table-row-select-checkbox" @attributes="@AdditionalAttributes"
             class="@SlotClasses.GetBase()"
             aria-label="@EffectiveAriaLabel"
             x-bind:checked="@CheckedExpr"
             x-bind:disabled="@DisabledExpr"
             x-indeterminate="@IndeterminateExpr"
             x-on:change="@ChangeExpr" />
