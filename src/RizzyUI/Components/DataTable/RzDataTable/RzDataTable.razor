@namespace RizzyUI
@typeparam TItem
@inherits RzComponent<RzDataTableSlots>

<HtmlElement Element="@EffectiveElement"
             id="@Id"
             data-slot="datatable" @attributes="@AdditionalAttributes"
             class="@SlotClasses.GetBase()">
    <div data-alpine-root="@Id"
         x-data="rzDataTable"
         x-load="@LoadStrategyOrNull"
         data-assets="@_assets"
         data-nonce="@Nonce"
         data-config-id="@ConfigScriptId">
        <script type="application/json"
                id="@ConfigScriptId"
                nonce="@Nonce">@((MarkupString)_configJson)</script>
        @if (_stateJson is not null)
        {
            @* D-31: the table's state as versioned JSON, kept in step by rzDataTable. *@
            <input type="hidden" name="@StateInputName" id="@StateInputId" value="@_stateJson"
                   data-datatable-state data-include-selection="@(IncludeSelectionInState ? "true" : null)" />
        }
        <CascadingValue Value="this" Name="ParentRzDataTable" IsFixed="true">
            @ChildContent
        </CascadingValue>
        <div class="@SlotClasses.GetAnnouncement()"
             data-slot="announcement"
             role="status"
             aria-live="polite"
             aria-atomic="true"
             x-text="announcement.message"></div>
    </div>
</HtmlElement>
