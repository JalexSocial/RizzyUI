@namespace RizzyUI
@inherits RzComponent<RzTableSlots>

<CascadingValue Value="this" Name="ParentRzTable" IsFixed="true">
    @* SF-063: the container scrolls, so it is focusable (keyboard scrolling) and, with AriaLabel, a named region. *@
    <HtmlElement Element="div" id="@Id" data-slot="table-container" tabindex="0"
                 role="@(string.IsNullOrWhiteSpace(AriaLabel) ? null : "region")" aria-label="@AriaLabel"
                 @attributes="@AdditionalAttributes" class="@SlotClasses.GetBase()">
        <table id="@TableId" class="@SlotClasses.GetTable()" data-slot="table">
            @ChildContent
        </table>
    </HtmlElement>
</CascadingValue>
