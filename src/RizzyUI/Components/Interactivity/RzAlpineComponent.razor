@namespace RizzyUI
@inherits RzAsChildComponent

@if (RenderPreload)
{
    @* Lets the browser fetch the module while it parses the page instead of after Alpine starts. *@
    <link rel="modulepreload" href="@ModuleUrl" nonce="@Nonce" />
}

@if (AsChild)
{
    @RenderAsChild()
}
else
{
    <HtmlElement Element="@EffectiveElement" data-slot="alpine-component" @attributes="GetComponentAttributes()">
        @ChildContent
    </HtmlElement>
}
