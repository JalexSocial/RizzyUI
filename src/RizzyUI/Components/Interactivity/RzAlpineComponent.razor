
@namespace RizzyUI
@inherits RzAsChildComponent
@using System.Text.Json

@if (AsChild)
{
    @RenderAsChild()
}
else
{
    <HtmlElement Element="@EffectiveElement" data-slot="alpine-component" @attributes="GetComponentAttributes()">
        @ChildContent
    </HtmlElement>
}

@if (Props is not null)
{
    <script type="application/json" id="@_propsScriptId" nonce="@Nonce">
        @((MarkupString)_serializedProps)
    </script>
}

@if (!string.IsNullOrEmpty(_modulePath))
{
    @* The arguments are JSON string literals (RZUI-054): HTML-encoding them inside a script turned
       quotes and non-ASCII characters into entities. *@
    <script nonce="@Nonce">
        (function (name, path) {
            if (window.Rizzy)
                window.Rizzy.registerAsyncComponent(name, path);
            else
                document.addEventListener("rz:init", e => e.detail.Rizzy.registerAsyncComponent(name, path), { once: true });
        })(@((MarkupString)_registrationArguments));
    </script>
}