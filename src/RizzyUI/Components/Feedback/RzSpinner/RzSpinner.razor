
@namespace RizzyUI
@inherits RzComponent<RzSpinner.Slots>

@* The status role and its name are on the wrapper: on the aria-hidden svg they were never
   announced (RZUI-047). Caller attributes come last, so role and aria-label can be overridden. *@
