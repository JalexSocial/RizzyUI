@namespace RizzyUI
@inherits RzComponent<RzAlertDialog.Slots>

<CascadingValue Value="this" IsFixed="true">
    @* Caller attributes first, so they cannot replace the component's own (RZUI-053). *@
    <div data-slot="alert-dialog" @attributes="AdditionalAttributes"
         x-data="rzModal" x-load="@LoadStrategyOrNull"
         id="@Id"
         data-alpine-root="@Id"
         data-modal-id="@Id"
         data-body-id="@BodyId"
         data-footer-id="@FooterId"
         data-nonce="@Nonce"
         data-event-trigger-name="@EventTriggerName"
         data-close-event-name="@CloseEventName"
         data-close-on-escape="@(CloseOnEscape.ToString().ToLowerInvariant())"
         data-close-on-click-outside="@(CloseOnClickOutside.ToString().ToLowerInvariant())"
         class="@SlotClasses.GetBase()">
        @ChildContent
    </div>
</CascadingValue>
