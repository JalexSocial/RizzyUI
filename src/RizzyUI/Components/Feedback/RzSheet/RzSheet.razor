
@namespace RizzyUI
@inherits RzComponent<RzSheet.Slots>

<CascadingValue Value="this" IsFixed="true">
    <HtmlElement Element="@EffectiveElement" 
                 @attributes="AdditionalAttributes" 
                 id="@Id" 
                 class="@SlotClasses.GetBase()"
                 data-slot="sheet"
                 x-data="rzSheet" x-load="@LoadStrategyOrNull"
                 data-alpine-root="@Id"
                 data-default-open="@DefaultOpen.ToString().ToLowerInvariant()"
                 data-modal="@Modal.ToString().ToLowerInvariant()"
                 data-dismiss-on-outside-click="@DismissOnOutsideClick.ToString().ToLowerInvariant()">
        @ChildContent
    </HtmlElement>
</CascadingValue>