@namespace RizzyUI
@inherits RzComponent<AvatarGroup.Slots>

<CascadingValue Value="this" IsFixed="true">
    <HtmlElement Element="@EffectiveElement"
                 id="@Id"
                 data-slot="@AvatarGroup.SlotNames.NameOf(SlotTypes.Base)" @attributes="@AdditionalAttributes"
                 class="@SlotClasses.GetBase()">
        @ChildContent
    </HtmlElement>
</CascadingValue>
