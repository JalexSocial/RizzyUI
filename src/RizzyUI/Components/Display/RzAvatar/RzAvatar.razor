
@namespace RizzyUI
@using TailwindVariants.NET
@inherits RzComponent<RzAvatar.Slots>

<CascadingValue Value="this" IsFixed="true">
	<HtmlElement Element="@EffectiveElement" role="img" data-slot="avatar" @attributes="@AdditionalAttributes"
	             aria-label="@EffectiveAriaLabel"
	             id="@Id"
             class="@(SlotClasses.GetBase())"
             data-size="@Size.ToString().ToKebabCase()">
        @ChildContent
    </HtmlElement>
</CascadingValue>