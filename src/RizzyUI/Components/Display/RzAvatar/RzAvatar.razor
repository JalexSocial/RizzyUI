
@namespace RizzyUI
@using TailwindVariants.NET
@inherits RzComponent<RzAvatar.Slots>

<CascadingValue Value="this" IsFixed="true">
	<HtmlElement Element="@EffectiveElement" role="@RootRole" data-slot="avatar" @attributes="@AdditionalAttributes"
	             aria-label="@RootAriaLabel"
	             aria-hidden="@(Decorative ? "true" : null)"
	             id="@Id"
             class="@(SlotClasses.GetBase())"
             data-size="@Size.ToString().ToKebabCase()">
        @ChildContent
    </HtmlElement>
</CascadingValue>