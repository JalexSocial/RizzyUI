
@namespace RizzyUI
@inherits RzComponent<RzIndicator.Slots>

<div data-slot="indicator" @attributes="@AdditionalAttributes" x-data="rzIndicator" x-load="@LoadStrategyOrNull"
     data-alpine-root="@Id"
     id="@Id"
     class="@SlotClasses.GetBase()"
     role="@(IsLabeled ? "img" : null)"
     aria-label="@(IsLabeled ? AriaLabel : null)"
     aria-hidden="@(IsLabeled ? null : "true")"
     x-bind:aria-hidden="@(IsLabeled ? "notVisible" : null)"
     x-show="visible"
     data-visible="@Visible.ToString().ToLowerInvariant()"
     x-cloak>
</div>