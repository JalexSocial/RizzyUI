@namespace RizzyUI
@inherits RzComponent<RzProgress.Slots>

<CascadingValue Value="this" IsFixed="true">
    <HtmlElement Element="@EffectiveElement"
                 data-slot="progress"
                 role="progressbar"
                 @attributes="AdditionalAttributes"
                 id="@Id"
                 class="@SlotClasses.GetBase()"
                 aria-label="@EffectiveAriaLabel"
                 aria-valuemin="@Format(Min)"
                 aria-valuemax="@Format(Max)"
                 aria-valuenow="@ValueNowText"
                 aria-valuetext="@EffectiveValueText"
                 data-state="@State"
                 data-value="@ValueNowText"
                 data-min="@Format(Min)"
                 data-max="@Format(Max)"
                 x-data="rzProgress"
                 x-load="@LoadStrategyOrNull"
                 data-alpine-root="@Id"
                 x-bind:aria-valuenow="valueNow"
                 x-bind:aria-valuetext="valueText"
                 x-bind:data-state="state">
        @if (ChildContent is null)
        {
            <ProgressIndicator />
        }
        else
        {
            @ChildContent
        }
    </HtmlElement>
</CascadingValue>
