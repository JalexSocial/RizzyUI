@attribute [RzAlpineCodeBehind]
@* Code-behind written in TypeScript (HarnessTypedCounter.razor.ts), built by RizzyUI's esbuild
   pipeline together with the helper module it imports. *@
<RzAlpineComponent For="this" AsChild Props="@(new { Label, Start })">
    <div class="flex items-center gap-3" data-testid="typed-counter">
        <span data-testid="label" x-text="title"></span>
        <button type="button" data-testid="decrement" x-on:click="decrement" class="rounded border px-2">-</button>
        <span data-testid="count" x-text="count"></span>
        <button type="button" data-testid="increment" x-on:click="increment" class="rounded border px-2">+</button>
    </div>
</RzAlpineComponent>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Start { get; set; }
}
