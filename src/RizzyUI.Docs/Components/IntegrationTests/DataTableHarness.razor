@page "/_tests/datatable"
@layout HarnessLayout
@using static RizzyUI.Docs.Components.IntegrationTests.DataTableHarnessData
@* RzDataTable integration harness: two independent real tables and htmx insert/replace/remove of
   one of them. Mapped only when Docs:EnableTestPages is true. *@

<PageTitle>DataTable harness</PageTitle>

<div class="space-y-10 p-6">
    <h1 class="text-2xl font-semibold">DataTable harness</h1>

    <section aria-labelledby="people-heading" class="space-y-3">
        <h2 id="people-heading" class="text-lg font-medium">People</h2>
        <div class="flex gap-2">
            <RzButton id="replace-people" hx-get="/_tests/datatable/people" hx-target="#people-host" hx-swap="innerHTML">Replace people table</RzButton>
            <RzButton id="remove-people" hx-get="/_tests/datatable/empty" hx-target="#people-host" hx-swap="innerHTML">Remove people table</RzButton>
        </div>
        <div id="people-host">
            <PeopleTable Round="0" />
        </div>
    </section>

    <section aria-labelledby="products-heading" class="space-y-3">
        <h2 id="products-heading" class="text-lg font-medium">Products</h2>
        <RzDataTable TItem="ProductRow" Id="products-table" Items="Products" Config="ProductsConfig" RowIdSelector="x => x.Id">
            <p id="products-selected"><span x-text="selectedRowCount"></span> selected</p>
            <RzTable Border>
                <TableCaption>Products</TableCaption>
                <TableHeader>
                    <template x-for="headerGroup in headerGroups" :key="headerGroup.id">
                        <TableRow>
                            <template x-for="header in headerGroup.headers" :key="header.id">
                                <TableHeaderCell x-bind:colspan="header.colSpan">
                                    <template x-if="!header.isPlaceholder">
                                        <span x-flexrender="_flex.header(header)"></span>
                                    </template>
                                </TableHeaderCell>
                            </template>
                        </TableRow>
                    </template>
                </TableHeader>
                <TableBody>
                    <template x-for="row in rows" :key="row.id">
                        <TableRow>
                            <template x-for="cell in row.cells" :key="cell.id">
                                <TableCell x-flexrender="_flex.cell(cell)"></TableCell>
                            </template>
                        </TableRow>
                    </template>
                </TableBody>
            </RzTable>
        </RzDataTable>
    </section>
</div>
