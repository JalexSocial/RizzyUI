
@namespace RizzyUI.Docs.Examples
@using RizzyUI

<div class="grid w-full max-w-sm gap-6">
    <EditForm Model="_model" x-data @submit.prevent>
        <FieldLabel For="@(() => _model.Search)" ForId="input-group-search" class="sr-only">Search</FieldLabel>
        <RzInputGroup>
            <RzInputText Id="input-group-search" For="@(() => _model.Search)" Placeholder="Search..." class="flex-1 rounded-none border-0 bg-transparent shadow-none focus-visible:ring-0 dark:bg-transparent" data-slot="input-group-control" />
            <InputGroupAddon>
                <Blazicon Svg="Lucide.Search" />
            </InputGroupAddon>
            <InputGroupAddon Align="InputGroupAddonAlign.InlineEnd">
                <InputGroupText>12 results</InputGroupText>
            </InputGroupAddon>
        </RzInputGroup>

        <FieldLabel For="@(() => _model.Domain)" ForId="input-group-domain" class="sr-only">Domain</FieldLabel>
        <RzInputGroup class="mt-6">
            <RzInputText Id="input-group-domain" For="@(() => _model.Domain)" Placeholder="example.com" class="flex-1 rounded-none border-0 bg-transparent shadow-none focus-visible:ring-0 dark:bg-transparent !pl-1" data-slot="input-group-control" />
            <InputGroupAddon>
                <InputGroupText>https://</InputGroupText>
            </InputGroupAddon>
            <InputGroupAddon Align="InputGroupAddonAlign.InlineEnd">
                <TooltipProvider>
                    <RzTooltip Anchor="AnchorPoint.Top">
                        <TooltipTrigger AsChild>
                            <InputGroupButton class="rounded-full" Size="InputGroupButtonSize.IconExtraSmall" aria-label="Info">
                                <Blazicon Svg="Lucide.Info" />
                            </InputGroupButton>
                        </TooltipTrigger>
                        <TooltipContent>This is content in a tooltip.</TooltipContent>
                    </RzTooltip>
                </TooltipProvider>
            </InputGroupAddon>
        </RzInputGroup>

        <FieldLabel For="@(() => _model.Prompt)" ForId="input-group-prompt" class="sr-only">Prompt</FieldLabel>
        <RzInputGroup class="mt-6">
            <RzInputTextArea Id="input-group-prompt" For="@(() => _model.Prompt)" Placeholder="Ask, Search or Chat..." class="flex-1 w-full resize-none rounded-none border-0 bg-transparent py-3 shadow-none focus-visible:ring-0 dark:bg-transparent" data-slot="input-group-control" />
            <InputGroupAddon Align="InputGroupAddonAlign.BlockEnd">
                <InputGroupButton Variant="ThemeVariant.Default" Outline class="rounded-full" Size="InputGroupButtonSize.IconExtraSmall" aria-label="Add">
                    <Blazicon Svg="Lucide.Plus" />
                </InputGroupButton>
                <RzDropdownMenu Anchor="AnchorPoint.TopStart">
                    <DropdownMenuTrigger AsChild>
                        <InputGroupButton Variant="ThemeVariant.Ghost" aria-label="Auto mode">Auto</InputGroupButton>
                    </DropdownMenuTrigger>
                    <DropdownMenuContent>
                        <DropdownMenuItem>Auto</DropdownMenuItem>
                        <DropdownMenuItem>Agent</DropdownMenuItem>
                        <DropdownMenuItem>Manual</DropdownMenuItem>
                    </DropdownMenuContent>
                </RzDropdownMenu>
                <InputGroupText class="ml-auto">52% used</InputGroupText>
                <RzSeparator Orientation="Orientation.Vertical" class="!h-4" />
                <InputGroupButton Variant="ThemeVariant.Default" class="rounded-full" Size="InputGroupButtonSize.IconExtraSmall" aria-label="Send">
                    <Blazicon Svg="Lucide.ArrowUp" />
                    <span class="sr-only">Send</span>
                </InputGroupButton>
            </InputGroupAddon>
        </RzInputGroup>

        <FieldLabel For="@(() => _model.Username)" ForId="input-group-username" class="sr-only">Username</FieldLabel>
        <RzInputGroup class="mt-6">
            <RzInputText Id="input-group-username" For="@(() => _model.Username)" Placeholder="@("@shadcn")" class="flex-1 rounded-none border-0 bg-transparent shadow-none focus-visible:ring-0 dark:bg-transparent" data-slot="input-group-control" />
            <InputGroupAddon Align="InputGroupAddonAlign.InlineEnd">
                <div class="bg-primary text-foreground flex size-4 items-center justify-center rounded-full">
                    <Blazicon Svg="Lucide.Check" class="size-3 text-white" />
                </div>
            </InputGroupAddon>
        </RzInputGroup>
    </EditForm>
</div>

@code {
    private DemoModel _model = new();
    public class DemoModel {
        public string Search { get; set; } = string.Empty;
        public string Domain { get; set; } = string.Empty;
        public string Prompt { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
    }
}