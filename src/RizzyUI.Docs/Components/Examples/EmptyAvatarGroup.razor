
@namespace RizzyUI.Docs.Examples
@using RizzyUI

<RzEmpty class="flex-none border py-10">
    <EmptyHeader>
        <EmptyMedia>
            <AvatarGroup class="grayscale">
                <RzAvatar>
                    <AvatarImage ImageSource="/images/avatars/avatar-shadcn.svg" AlternateText="@("@shadcn")" loading="lazy" decoding="async" width="96" height="96" />
                    <AvatarFallback>CN</AvatarFallback>
                </RzAvatar>
                <RzAvatar>
                    <AvatarImage ImageSource="/images/avatars/avatar-maxleiter.svg" AlternateText="@("@maxleiter")" loading="lazy" decoding="async" width="96" height="96" />
                    <AvatarFallback>LR</AvatarFallback>
                </RzAvatar>
                <RzAvatar>
                    <AvatarImage ImageSource="/images/avatars/avatar-evilrabbit.svg" AlternateText="@("@evilrabbit")" loading="lazy" decoding="async" width="96" height="96" />
                    <AvatarFallback>ER</AvatarFallback>
                </RzAvatar>
            </AvatarGroup>
        </EmptyMedia>
        <EmptyTitle>No Team Members</EmptyTitle>
        <EmptyDescription>
            Invite your team to collaborate on this project.
        </EmptyDescription>
    </EmptyHeader>
    <EmptyContent>
        <RzButton Size="Size.Small" AriaLabel="Invite Members">
            <Blazicon Svg="Lucide.Plus" />
            Invite Members
        </RzButton>
    </EmptyContent>
</RzEmpty>