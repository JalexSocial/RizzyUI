@namespace RizzyUI.Docs.Examples
@using RizzyUI

<div class="flex flex-row flex-wrap items-center gap-6 md:gap-12">
    <RzAvatar>
        <AvatarImage ImageSource="/images/avatars/avatar-shadcn.svg" alt="@("@shadcn")" class="grayscale" />
        <AvatarFallback>CN</AvatarFallback>
    </RzAvatar>
    
    <RzAvatar>
        <AvatarImage ImageSource="/images/avatars/avatar-evilrabbit.svg" alt="@("@evilrabbit")" />
        <AvatarFallback>ER</AvatarFallback>
        <AvatarBadge class="bg-green-600 dark:bg-green-800" />
    </RzAvatar>
    
    <AvatarGroup class="grayscale">
        <RzAvatar>
            <AvatarImage ImageSource="/images/avatars/avatar-shadcn.svg" alt="@("@shadcn")" />
            <AvatarFallback>CN</AvatarFallback>
        </RzAvatar>
        <RzAvatar>
            <AvatarImage ImageSource="/images/avatars/avatar-maxleiter.svg" alt="@("@maxleiter")" />
            <AvatarFallback>LR</AvatarFallback>
        </RzAvatar>
        <RzAvatar>
            <AvatarImage ImageSource="/images/avatars/avatar-evilrabbit.svg" alt="@("@evilrabbit")" />
            <AvatarFallback>ER</AvatarFallback>
        </RzAvatar>
        <AvatarGroupCount>+3</AvatarGroupCount>
    </AvatarGroup>
</div>