@namespace RizzyUI.Docs.Examples
@using RizzyUI

<RzCard class="py-4 shadow-none">
    <CardContent class="px-4">
        <EditForm Model="_model">
            <RzFieldGroup>
                <RzFieldSet class="gap-4">
                    <FieldLegend>How did you hear about us?</FieldLegend>
                    <FieldDescription class="line-clamp-1">
                        Select the option that best describes how you heard about us.
                    </FieldDescription>
                    <RzFieldGroup class="flex flex-row flex-wrap gap-2 [--radius:9999rem]">
                        <Field Orientation="FieldOrientation.Horizontal" class="gap-1.5 p-0!">
                            <RzInputCheckbox Id="social-media" For="@(() => _model.SocialMedia)" class="peer sr-only" />
                            <FieldLabel For="(() => _model.SocialMedia)" ForId="social-media" class="!w-fit cursor-pointer rounded-full border px-3! py-1.5! transition-colors peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground">Social Media</FieldLabel>
                        </Field>

                        <Field Orientation="FieldOrientation.Horizontal" class="gap-1.5 p-0!">
                            <RzInputCheckbox Id="search-engine" For="@(() => _model.SearchEngine)" class="peer sr-only" />
                            <FieldLabel For="(() => _model.SearchEngine)" ForId="search-engine" class="!w-fit cursor-pointer rounded-full border px-3! py-1.5! transition-colors peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground">Search Engine</FieldLabel>
                        </Field>

                        <Field Orientation="FieldOrientation.Horizontal" class="gap-1.5 p-0!">
                            <RzInputCheckbox Id="referral" For="@(() => _model.Referral)" class="peer sr-only" />
                            <FieldLabel For="(() => _model.Referral)" ForId="referral" class="!w-fit cursor-pointer rounded-full border px-3! py-1.5! transition-colors peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground">Referral</FieldLabel>
                        </Field>

                        <Field Orientation="FieldOrientation.Horizontal" class="gap-1.5 p-0!">
                            <RzInputCheckbox Id="other" For="@(() => _model.Other)" class="peer sr-only" />
                            <FieldLabel For="(() => _model.Other)" ForId="other" class="!w-fit cursor-pointer rounded-full border px-3! py-1.5! transition-colors peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-foreground">Other</FieldLabel>
                        </Field>
                    </RzFieldGroup>
                </RzFieldSet>
            </RzFieldGroup>
        </EditForm>
    </CardContent>
</RzCard>

@code {
    private HearModel _model = new();

    public class HearModel
    {
        public bool SocialMedia { get; set; } = true;
        public bool SearchEngine { get; set; }
        public bool Referral { get; set; }
        public bool Other { get; set; }
    }
}
