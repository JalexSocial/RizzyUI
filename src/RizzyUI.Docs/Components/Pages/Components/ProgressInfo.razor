@page "/components/progress"
@using RizzyUI

<PageTitle>RzProgress</PageTitle>

<RzQuickReferenceContainer>
    <RzArticle ProseWidth="ProseWidth.UltraWide">
        <SideContent>
            <RzQuickReference />
        </SideContent>
        <MainContent>
            <RzBreadcrumb class="mb-4 not-prose">
                <BreadcrumbList>
                    <BreadcrumbItem>
                        <BreadcrumbLink Href="/" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Docs</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem>
                        <BreadcrumbLink Href="/components" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Components</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem>
                        <BreadcrumbPage>Progress</BreadcrumbPage>
                    </BreadcrumbItem>
                </BreadcrumbList>
            </RzBreadcrumb>

            <RzHeading Level="HeadingLevel.H1" class="scroll-mt-20">RzProgress</RzHeading>
            <RzParagraph>
                Shows how far a task has got, such as an upload or a multi-step process. <code>RzProgress</code> is the track;
                <code>ProgressIndicator</code> is the bar inside it. Style either one with <code>class</code>.
            </RzParagraph>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Usage" class="scroll-mt-20" Id="usage">Usage</RzHeading>
                <RzParagraph>
                    Give it a <code>Value</code> (0 to 100 by default) and a name: a visible label referenced with
                    <code>aria-labelledby</code>, or <code>AriaLabel</code> when there is no visible label.
                </RzParagraph>
                <RzBrowser Layout="typeof(PreviewLayout)">
                    <div class="mx-auto w-full max-w-md space-y-2 p-8">
                        <p id="usage-label" class="text-sm font-medium">Uploading report.pdf</p>
                        <RzProgress Value="33" aria-labelledby="usage-label" />
                    </div>
                </RzBrowser>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;p id=&quot;usage-label&quot;&gt;Uploading report.pdf&lt;/p&gt;
&lt;RzProgress Value=&quot;33&quot; aria-labelledby=&quot;usage-label&quot; /&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Range and value text" class="scroll-mt-20" Id="range">Range and value text</RzHeading>
                <RzParagraph>
                    Use <code>Min</code> and <code>Max</code> for any range; values can be decimals. Screen readers
                    announce the percentage, or <code>ValueText</code> when you set it (pass localized text).
                </RzParagraph>
                <RzBrowser Layout="typeof(PreviewLayout)">
                    <div class="mx-auto w-full max-w-md space-y-2 p-8">
                        <div class="flex items-center justify-between text-sm">
                            <span id="files-label" class="font-medium">Copying files</span>
                            <span class="text-muted-foreground">7 of 12</span>
                        </div>
                        <RzProgress Value="7" Max="12" ValueText="7 of 12 files" aria-labelledby="files-label" />
                    </div>
                </RzBrowser>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;div class=&quot;flex items-center justify-between text-sm&quot;&gt;
    &lt;span id=&quot;files-label&quot; class=&quot;font-medium&quot;&gt;Copying files&lt;/span&gt;
    &lt;span class=&quot;text-muted-foreground&quot;&gt;@@done of @@total&lt;/span&gt;
&lt;/div&gt;
&lt;RzProgress Value=&quot;@@done&quot; Max=&quot;@@total&quot; ValueText=&quot;@@($&quot;{done} of {total} files&quot;)&quot; aria-labelledby=&quot;files-label&quot; /&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Styling the track and the bar" class="scroll-mt-20" Id="styling">Styling the track and the bar</RzHeading>
                <RzParagraph>
                    <code>class</code> on <code>RzProgress</code> styles the track (height, color, radius). To style the bar, add a
                    <code>ProgressIndicator</code> with its own <code>class</code>. Classes are merged, so yours replace the defaults
                    they conflict with.
                </RzParagraph>
                <RzBrowser Layout="typeof(PreviewLayout)">
                    <div class="mx-auto w-full max-w-md space-y-6 p-8">
                        <RzProgress Value="45" class="h-1 bg-muted" AriaLabel="Thin progress bar">
                            <ProgressIndicator class="bg-foreground" />
                        </RzProgress>
                        <RzProgress Value="70" class="h-3 rounded-sm" AriaLabel="Square progress bar">
                            <ProgressIndicator class="bg-gradient-to-r from-sky-500 to-indigo-500" />
                        </RzProgress>
                    </div>
                </RzBrowser>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;RzProgress Value=&quot;45&quot; class=&quot;h-1 bg-muted&quot; AriaLabel=&quot;Thin progress bar&quot;&gt;
    &lt;ProgressIndicator class=&quot;bg-foreground&quot; /&gt;
&lt;/RzProgress&gt;

&lt;RzProgress Value=&quot;70&quot; class=&quot;h-3 rounded-sm&quot; AriaLabel=&quot;Square progress bar&quot;&gt;
    &lt;ProgressIndicator class=&quot;bg-gradient-to-r from-sky-500 to-indigo-500&quot; /&gt;
&lt;/RzProgress&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Colors" class="scroll-mt-20" Id="colors">Colors</RzHeading>
                <RzParagraph>
                    <code>Variant</code> is a shortcut for the bar color.
                </RzParagraph>
                <RzBrowser Layout="typeof(PreviewLayout)">
                    <div class="mx-auto w-full max-w-md space-y-4 p-8">
                        <RzProgress Value="40" Variant="StatusColor.Primary" AriaLabel="Primary" />
                        <RzProgress Value="55" Variant="StatusColor.Success" AriaLabel="Success" />
                        <RzProgress Value="65" Variant="StatusColor.Info" AriaLabel="Info" />
                        <RzProgress Value="80" Variant="StatusColor.Warning" AriaLabel="Warning" />
                        <RzProgress Value="90" Variant="StatusColor.Destructive" AriaLabel="Destructive" />
                    </div>
                </RzBrowser>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;RzProgress Value=&quot;55&quot; Variant=&quot;StatusColor.Success&quot; AriaLabel=&quot;Backup&quot; /&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Label inside the bar" class="scroll-mt-20" Id="inside-label">Label inside the bar</RzHeading>
                <RzParagraph>
                    <code>ProgressLabel</code> centers text on the bar with CSS. Without content it shows the rounded percentage and
                    keeps it up to date. Make the track tall enough for the text. The label is hidden from screen readers, which read
                    the bar's value instead.
                </RzParagraph>
                <RzBrowser Layout="typeof(PreviewLayout)">
                    <div class="mx-auto w-full max-w-md space-y-4 p-8">
                        <RzProgress Value="62" class="h-4" AriaLabel="Install progress">
                            <ProgressIndicator class="bg-primary/40" />
                            <ProgressLabel />
                        </RzProgress>
                        <RzProgress Value="3" Max="5" class="h-5" ValueText="Step 3 of 5" AriaLabel="Setup">
                            <ProgressIndicator class="bg-success/40" />
                            <ProgressLabel>Step 3 of 5</ProgressLabel>
                        </RzProgress>
                    </div>
                </RzBrowser>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;RzProgress Value=&quot;62&quot; class=&quot;h-4&quot; AriaLabel=&quot;Install progress&quot;&gt;
    &lt;ProgressIndicator class=&quot;bg-primary/40&quot; /&gt;
    &lt;ProgressLabel /&gt;
&lt;/RzProgress&gt;

&lt;RzProgress Value=&quot;3&quot; Max=&quot;5&quot; class=&quot;h-5&quot; ValueText=&quot;Step 3 of 5&quot; AriaLabel=&quot;Setup&quot;&gt;
    &lt;ProgressIndicator class=&quot;bg-success/40&quot; /&gt;
    &lt;ProgressLabel&gt;Step 3 of 5&lt;/ProgressLabel&gt;
&lt;/RzProgress&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Indeterminate" class="scroll-mt-20" Id="indeterminate">Indeterminate</RzHeading>
                <RzParagraph>
                    When you can't tell how far along the task is, pass <code>Value="null"</code>. The bar animates (or stays still for
                    users who prefer reduced motion) and the progress bar has no <code>aria-valuenow</code>.
                </RzParagraph>
                <RzBrowser Layout="typeof(PreviewLayout)">
                    <div class="mx-auto w-full max-w-md p-8">
                        <RzProgress Value="null" AriaLabel="Connecting" />
                    </div>
                </RzBrowser>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;RzProgress Value=&quot;null&quot; AriaLabel=&quot;Connecting&quot; /&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Updating from JavaScript" class="scroll-mt-20" Id="javascript">Updating from JavaScript</RzHeading>
                <RzParagraph>
                    The progress bar is an Alpine component (<code>rzProgress</code>). Get it with <code>Rizzy.$data</code> and update it;
                    the bar, <code>aria-valuenow</code> and <code>data-state</code> follow. In a code-behind module, get it in
                    <code>ready()</code>.
                </RzParagraph>
                <RzCodeViewer Language="@CodeLanguage.JavaScript" class="mb-6">
const progress = Rizzy.$data('upload-progress');   // the RzProgress Id
progress.setProgress(40);                          // aria-valuetext: the percentage
progress.setProgress(4, '4 of 10 files');          // with a value text
progress.increment(5);
progress.setIndeterminate();
                </RzCodeViewer>
                <div class="not-prose mt-6 mb-10 overflow-x-auto rounded-md border border-zinc-200 dark:border-zinc-800">
                    <table class="w-full text-sm">
                        <thead class="text-left bg-zinc-100/75 font-semibold text-zinc-700 dark:bg-zinc-900/50 dark:text-zinc-300">
                            <tr><th scope="col" class="w-1/4 px-4 py-3">Member</th><th scope="col" class="px-4 py-3">Description</th></tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                            <tr class="align-top"><td class="px-4 py-3"><code>setProgress(value, valueText?)</code></td><td class="px-4 py-3">Sets the value; <code>null</code> makes the bar indeterminate. Without <code>valueText</code>, screen readers read the percentage.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>increment(step = 1)</code></td><td class="px-4 py-3">Adds <code>step</code>, up to <code>Max</code>. An indeterminate bar starts at <code>Min</code>.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>decrement(step = 1)</code></td><td class="px-4 py-3">Subtracts <code>step</code>, down to <code>Min</code>.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>setIndeterminate()</code></td><td class="px-4 py-3">Makes the bar indeterminate.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>value</code>, <code>percentage</code>, <code>state</code></td><td class="px-4 py-3">Read the current value (or <code>null</code>), the percentage (0–100) and <code>loading</code>, <code>complete</code> or <code>indeterminate</code>.</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Accessibility" class="scroll-mt-20" Id="accessibility">Accessibility</RzHeading>
                <ul class="list-disc space-y-2 pl-6 my-4 text-foreground">
                    <li>The track is a single element with <code>role="progressbar"</code>, <code>aria-valuemin</code>, <code>aria-valuemax</code> and, unless indeterminate, <code>aria-valuenow</code>.</li>
                    <li>A progress bar needs a name: point <code>aria-labelledby</code> to visible text, or set <code>AriaLabel</code>. There is no default name.</li>
                    <li><code>ValueText</code> (or <code>setProgress(value, valueText)</code>) sets <code>aria-valuetext</code> for values a percentage does not describe well.</li>
                    <li>Progress bars are not live regions: screen readers read the value when the user reaches it. Announce milestones (for example "Upload complete") yourself, for example with a toast.</li>
                    <li>Animations respect <code>prefers-reduced-motion</code>.</li>
                </ul>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Parameters" class="scroll-mt-20" Id="parameters">Parameters</RzHeading>
                <RzHeading Level="HeadingLevel.H3" class="mt-6">RzProgress</RzHeading>
                <div class="not-prose mt-4 mb-8 overflow-x-auto rounded-md border border-zinc-200 dark:border-zinc-800">
                    <table class="w-full text-sm">
                        <thead class="text-left bg-zinc-100/75 font-semibold text-zinc-700 dark:bg-zinc-900/50 dark:text-zinc-300">
                            <tr><th scope="col" class="w-1/5 px-4 py-3">Parameter</th><th scope="col" class="w-1/5 px-4 py-3">Type</th><th scope="col" class="w-1/6 px-4 py-3">Default</th><th scope="col" class="px-4 py-3">Description</th></tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                            <tr class="align-top"><td class="px-4 py-3"><code>Value</code></td><td class="px-4 py-3"><code>double?</code></td><td class="px-4 py-3"><code>null</code></td><td class="px-4 py-3">The current value. <code>null</code> is indeterminate.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>Min</code></td><td class="px-4 py-3"><code>double</code></td><td class="px-4 py-3"><code>0</code></td><td class="px-4 py-3">The value of an empty bar.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>Max</code></td><td class="px-4 py-3"><code>double</code></td><td class="px-4 py-3"><code>100</code></td><td class="px-4 py-3">The value of a full bar.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>Variant</code></td><td class="px-4 py-3"><code>StatusColor</code></td><td class="px-4 py-3"><code>Primary</code></td><td class="px-4 py-3">The bar color.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>ValueText</code></td><td class="px-4 py-3"><code>string?</code></td><td class="px-4 py-3"><code>null</code></td><td class="px-4 py-3"><code>aria-valuetext</code>, read instead of the percentage.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>AriaLabel</code></td><td class="px-4 py-3"><code>string?</code></td><td class="px-4 py-3"><code>null</code></td><td class="px-4 py-3">The accessible name when there is no visible label for <code>aria-labelledby</code>.</td></tr>
                            <tr class="align-top"><td class="px-4 py-3"><code>ChildContent</code></td><td class="px-4 py-3"><code>RenderFragment?</code></td><td class="px-4 py-3"><code>null</code></td><td class="px-4 py-3">A <code>ProgressIndicator</code> and optionally a <code>ProgressLabel</code>. A default indicator is rendered when empty.</td></tr>
                        </tbody>
                    </table>
                </div>
                <RzHeading Level="HeadingLevel.H3" class="mt-6">ProgressIndicator and ProgressLabel</RzHeading>
                <RzParagraph>
                    Both take <code>class</code> and other attributes. <code>ProgressLabel</code> takes <code>ChildContent</code>; without
                    it, it shows the rounded percentage. Theme slots (<code>RzProgress</code>, <code>ProgressIndicator</code>,
                    <code>ProgressLabel</code> in <code>RzTheme</code>) set app-wide defaults.
                </RzParagraph>
            </section>
        </MainContent>
    </RzArticle>
</RzQuickReferenceContainer>
