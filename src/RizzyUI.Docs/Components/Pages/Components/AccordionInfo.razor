                                <td class="px-4 py-4 text-zinc-500"><code class="font-mono">string.Empty</code></td>
                            </tr>
                            <tr class="align-top">
                                <td class="px-4 py-4"><code class="font-mono font-medium text-sky-600 dark:text-sky-400">Collapsed</code></td>
                                <td class="px-4 py-4 text-zinc-600 dark:text-zinc-400">Boolean – Determines if the section is initially collapsed (<code>true</code>) or expanded (<code>false</code>).</td>
                                <td class="px-4 py-4"><code class="font-mono text-violet-600 dark:text-violet-400">bool</code></td>
                                <td class="px-4 py-4 text-zinc-500"><code class="font-mono">true</code></td>
