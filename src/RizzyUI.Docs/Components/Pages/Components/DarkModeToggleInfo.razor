@page "/components/dark-mode-toggle"

<PageTitle>Dark Mode Toggle</PageTitle>

<RzQuickReferenceContainer>
    <RzArticle ProseWidth="ProseWidth.Wide">
        <SideContent>
            <RzQuickReference />
        </SideContent>
        <MainContent>
            <RzBreadcrumb class="mb-4 not-prose">
                <BreadcrumbList>
                    <BreadcrumbItem><BreadcrumbLink Href="/" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Docs</BreadcrumbLink></BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem><BreadcrumbLink Href="/components" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Components</BreadcrumbLink></BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem><BreadcrumbPage>Dark Mode Toggle</BreadcrumbPage></BreadcrumbItem>
                </BreadcrumbList>
            </RzBreadcrumb>
            <RzHeading Level="HeadingLevel.H1" QuickReferenceTitle="Dark Mode Toggle" class="scroll-mt-20">Dark Mode Toggle</RzHeading>
            <RzParagraph>Switches between the light and dark variants of the current theme and remembers the choice in the browser. It shows the icon of the mode it switches to.</RzParagraph>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Example" class="scroll-mt-20">Example</RzHeading>
                <div class="not-prose my-4 rounded-lg border p-6">
                    <RzDarkModeToggle />
                </div>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;RzDarkModeToggle /&gt;

&lt;!-- Other icons --&gt;
&lt;RzDarkModeToggle DarkIcon="Lucide.Moon" LightIcon="Lucide.Sun" /&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Parameters" class="scroll-mt-20">Parameters</RzHeading>
                <div class="not-prose mt-6 mb-10 overflow-x-auto rounded-md border">
                    <table class="w-full text-sm">
                        <thead class="bg-muted text-left font-semibold">
                            <tr><th scope="col" class="p-4">Parameter</th><th scope="col" class="p-4">Type</th><th scope="col" class="p-4">Default</th><th scope="col" class="p-4">Description</th></tr>
                        </thead>
                        <tbody class="divide-y">
                            <tr class="align-top"><td class="p-4"><code>DarkIcon</code></td><td class="p-4"><code>SvgIcon</code></td><td class="p-4"><code>Ionicon.MoonOutline</code></td><td class="p-4">The icon shown in light mode (it switches to dark).</td></tr>
                            <tr class="align-top"><td class="p-4"><code>LightIcon</code></td><td class="p-4"><code>SvgIcon</code></td><td class="p-4"><code>Ionicon.SunnyOutline</code></td><td class="p-4">The icon shown in dark mode.</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </MainContent>
    </RzArticle>
</RzQuickReferenceContainer>
