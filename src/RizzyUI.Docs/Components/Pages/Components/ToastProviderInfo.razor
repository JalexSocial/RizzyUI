    private static RenderFragment RenderTable(IReadOnlyList<TableRow> rows, string firstHeader, string secondHeader, string thirdHeader, string fourthHeader) => @<div class="not-prose mt-4 mb-10 overflow-hidden rounded-md border border-zinc-200 dark:border-zinc-800">
        <table class="w-full text-sm">
            <thead class="bg-zinc-100/75 text-left font-semibold text-zinc-700 dark:bg-zinc-900/50 dark:text-zinc-300">
                <tr>
                    <th scope="col" class="w-1/5 px-4 py-3">@firstHeader</th>
                    <th scope="col" class="w-2/5 px-4 py-3">@secondHeader</th>
                    <th scope="col" class="w-1/5 px-4 py-3">@thirdHeader</th>
                    <th scope="col" class="px-4 py-3">@fourthHeader</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                @foreach (var row in rows)
                {
                    <tr class="align-top">
                        <td class="px-4 py-4"><code class="font-mono font-medium text-sky-600 dark:text-sky-400">@row.First</code></td>
                        <td class="px-4 py-4 text-zinc-600 dark:text-zinc-400">@row.Second</td>
                        <td class="px-4 py-4"><code class="font-mono text-violet-600 dark:text-violet-400">@row.Third</code></td>
                        <td class="px-4 py-4 text-zinc-500">@row.Fourth</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>;

    private sealed record TableRow(string First, string Second, string Third, string Fourth);

    private sealed record TroubleshootingItem(string Title, string Description);
