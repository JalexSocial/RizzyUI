@page "/components/id-scope"

<PageTitle>Id Scope</PageTitle>

<RzQuickReferenceContainer>
    <RzArticle ProseWidth="ProseWidth.Wide">
        <SideContent>
            <RzQuickReference />
        </SideContent>
        <MainContent>
            <RzBreadcrumb class="mb-4 not-prose">
                <BreadcrumbList>
                    <BreadcrumbItem><BreadcrumbLink Href="/" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Docs</BreadcrumbLink></BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem><BreadcrumbLink Href="/components" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Components</BreadcrumbLink></BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem><BreadcrumbPage>Id Scope</BreadcrumbPage></BreadcrumbItem>
                </BreadcrumbList>
            </RzBreadcrumb>
            <RzHeading Level="HeadingLevel.H1" QuickReferenceTitle="Id Scope" class="scroll-mt-20">Id Scope</RzHeading>
            <RzParagraph>RizzyUI components generate an id for themselves, different on every render. <code>RzIdScope</code> gives the components inside it deterministic ids instead (<code>{Prefix}-1</code>, <code>{Prefix}-2</code>, in render order), so the same markup always renders the same ids. Use it for a fragment that htmx re-renders and swaps (a morph swap matches elements by id, and focus and ARIA references survive) and for snapshot tests. Components with an explicit <code>Id</code> keep it.</RzParagraph>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Example" class="scroll-mt-20">Example</RzHeading>
                <div class="not-prose my-4 rounded-lg border p-6">
                    <RzIdScope Prefix="cart">
                        <RzBadge>Gift wrap</RzBadge>
                    </RzIdScope>
                </div>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;RzIdScope Prefix="cart"&gt;
    &lt;!-- The badge renders id="cart-1" on every render. --&gt;
    &lt;RzBadge&gt;Gift wrap&lt;/RzBadge&gt;
&lt;/RzIdScope&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Parameters" class="scroll-mt-20">Parameters</RzHeading>
                <div class="not-prose mt-6 mb-10 overflow-x-auto rounded-md border">
                    <table class="w-full text-sm">
                        <thead class="bg-muted text-left font-semibold">
                            <tr><th scope="col" class="p-4">Parameter</th><th scope="col" class="p-4">Type</th><th scope="col" class="p-4">Default</th><th scope="col" class="p-4">Description</th></tr>
                        </thead>
                        <tbody class="divide-y">
                            <tr class="align-top"><td class="p-4"><code>Prefix</code></td><td class="p-4"><code>string</code></td><td class="p-4">Required</td><td class="p-4">The id prefix, unique on the page and without whitespace. Two scopes with the same prefix render the same ids.</td></tr>
                            <tr class="align-top"><td class="p-4"><code>ChildContent</code></td><td class="p-4"><code>RenderFragment?</code></td><td class="p-4"><code>null</code></td><td class="p-4">The content whose components get scoped ids.</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </MainContent>
    </RzArticle>
</RzQuickReferenceContainer>
