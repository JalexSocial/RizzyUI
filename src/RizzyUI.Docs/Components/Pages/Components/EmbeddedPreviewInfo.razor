@page "/components/embedded-preview"

<PageTitle>Embedded Preview</PageTitle>

<RzQuickReferenceContainer>
    <RzArticle ProseWidth="ProseWidth.Wide">
        <SideContent>
            <RzQuickReference />
        </SideContent>
        <MainContent>
            <RzBreadcrumb class="mb-4 not-prose">
                <BreadcrumbList>
                    <BreadcrumbItem><BreadcrumbLink Href="/" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Docs</BreadcrumbLink></BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem><BreadcrumbLink Href="/components" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Components</BreadcrumbLink></BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem><BreadcrumbPage>Embedded Preview</BreadcrumbPage></BreadcrumbItem>
                </BreadcrumbList>
            </RzBreadcrumb>
            <RzHeading Level="HeadingLevel.H1" QuickReferenceTitle="Embedded Preview" class="scroll-mt-20">Embedded Preview</RzHeading>
            <RzParagraph>Renders its content into an <code>iframe</code>, isolated from the page's styles and scripts, with an optional layout around it. <code>RzBrowser</code> uses it for the previews on these pages; use it directly for an isolated preview without the browser frame.</RzParagraph>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Example" class="scroll-mt-20">Example</RzHeading>
                <div class="not-prose my-4 rounded-lg border p-6">
                    <RzEmbeddedPreview Layout="typeof(PreviewLayout)" IFrameTitle="A button in an iframe">
                        <RzButton>Inside an iframe</RzButton>
                    </RzEmbeddedPreview>
                </div>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;RzEmbeddedPreview Layout="typeof(PreviewLayout)" IFrameTitle="A button in an iframe"&gt;
    &lt;RzButton&gt;Inside an iframe&lt;/RzButton&gt;
&lt;/RzEmbeddedPreview&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Parameters" class="scroll-mt-20">Parameters</RzHeading>
                <div class="not-prose mt-6 mb-10 overflow-x-auto rounded-md border">
                    <table class="w-full text-sm">
                        <thead class="bg-muted text-left font-semibold">
                            <tr><th scope="col" class="p-4">Parameter</th><th scope="col" class="p-4">Type</th><th scope="col" class="p-4">Default</th><th scope="col" class="p-4">Description</th></tr>
                        </thead>
                        <tbody class="divide-y">
                            <tr class="align-top"><td class="p-4"><code>ChildContent</code></td><td class="p-4"><code>RenderFragment</code></td><td class="p-4">Required</td><td class="p-4">The content rendered inside the iframe.</td></tr>
                            <tr class="align-top"><td class="p-4"><code>Layout</code></td><td class="p-4"><code>Type?</code></td><td class="p-4"><code>null</code></td><td class="p-4">A layout component around the content (it should load your stylesheets and RizzyUI's scripts).</td></tr>
                            <tr class="align-top"><td class="p-4"><code>IFrameTitle</code></td><td class="p-4"><code>string?</code></td><td class="p-4">Localized "Embedded Content Preview"</td><td class="p-4">The iframe's title, its accessible name.</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </MainContent>
    </RzArticle>
</RzQuickReferenceContainer>
