@page "/components/search-button"

<PageTitle>Search Button</PageTitle>

<RzQuickReferenceContainer>
    <RzArticle ProseWidth="ProseWidth.Wide">
        <SideContent>
            <RzQuickReference />
        </SideContent>
        <MainContent>
            <RzBreadcrumb class="mb-4 not-prose">
                <BreadcrumbList>
                    <BreadcrumbItem><BreadcrumbLink Href="/" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Docs</BreadcrumbLink></BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem><BreadcrumbLink Href="/components" hx-boost="true" hx-select="#content" hx-target="#content" hx-swap="outerHTML">Components</BreadcrumbLink></BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem><BreadcrumbPage>Search Button</BreadcrumbPage></BreadcrumbItem>
                </BreadcrumbList>
            </RzBreadcrumb>
            <RzHeading Level="HeadingLevel.H1" QuickReferenceTitle="Search Button" class="scroll-mt-20">Search Button</RzHeading>
            <RzParagraph>A button styled as a search field, for opening a search palette (an <code>RzCommandDialog</code> with a <code>Shortcut</code>). Give it the handler that opens the palette.</RzParagraph>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Example" class="scroll-mt-20">Example</RzHeading>
                <div class="not-prose my-4 rounded-lg border p-6">
                    <RzSearchButton Label="Search the docs" />
                </div>
                <RzCodeViewer Language="@CodeLanguage.Razor" class="mb-10">
&lt;RzSearchButton Label="Search the docs" x-on:click="$dispatch('docs:open-search')" /&gt;

&lt;RzCommandDialog EventTriggerName="docs:open-search" Shortcut="k" ItemsUrl="/api/search" ServerFiltering="true"&gt;
    ...
&lt;/RzCommandDialog&gt;
                </RzCodeViewer>
            </section>

            <section class="my-8 py-2">
                <RzHeading Level="HeadingLevel.H2" QuickReferenceTitle="Parameters" class="scroll-mt-20">Parameters</RzHeading>
                <div class="not-prose mt-6 mb-10 overflow-x-auto rounded-md border">
                    <table class="w-full text-sm">
                        <thead class="bg-muted text-left font-semibold">
                            <tr><th scope="col" class="p-4">Parameter</th><th scope="col" class="p-4">Type</th><th scope="col" class="p-4">Default</th><th scope="col" class="p-4">Description</th></tr>
                        </thead>
                        <tbody class="divide-y">
                            <tr class="align-top"><td class="p-4"><code>Label</code></td><td class="p-4"><code>string?</code></td><td class="p-4">Localized "Search"</td><td class="p-4">The text on the button, also its accessible name.</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </MainContent>
    </RzArticle>
</RzQuickReferenceContainer>
