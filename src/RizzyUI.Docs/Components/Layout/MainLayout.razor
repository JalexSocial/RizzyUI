@code {
    [CascadingParameter]
    private RzTheme Theme { get; set; } = null!;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    // The sidebar link for the current page gets aria-current="page" (SidebarMenuButton IsActive).
    // Boosted navigation swaps only #content, so js/site.js updates it after each navigation.
    private bool IsCurrent(string href) =>
        string.Equals(NormalizePath(new Uri(Navigation.Uri).AbsolutePath), NormalizePath(href), StringComparison.OrdinalIgnoreCase);

    private static string NormalizePath(string path)
    {
        if (path.EndsWith(".html", StringComparison.OrdinalIgnoreCase))
            path = path[..^".html".Length];
        path = path.TrimEnd('/');
        return path.Length == 0 || path.Equals("/index", StringComparison.OrdinalIgnoreCase) ? "/" : path;
    }
}
