
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Code-behind modules (*.razor.js, *.razor.ts) are built with esbuild (RizzyUI.targets). -->
    <RizzyUICodeBehindBuild>esbuild</RizzyUICodeBehindBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\css\app.css" />

  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetStatic" Version="0.27.2" />
    <PackageReference Include="Blazicons.FluentUI" Version="2.21.119" />
    <PackageReference Include="Rizzy" Version="6.0.0-preview.3" />
    <PackageReference Include="Blazicons.MaterialDesignIcons" Version="2.2.26" />
    <PackageReference Include="RizzyUI.Tasks" Version="$(RizzyUITasksVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RizzyUI\RizzyUI.csproj" />
  </ItemGroup>

  <!-- npm ci only when node_modules is missing or older than package-lock.json (RZUI-046). `npm install`
       on every build reinstalled packages and could rewrite the tracked lockfile. -->
  <Target Name="EnsureNodeModules" BeforeTargets="Build" Inputs="package-lock.json" Outputs="node_modules/.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" />
  </Target>

  <Target Name="Tailwind" BeforeTargets="Build">
    <Exec Command="npm run build:css" />
  </Target>
    
    <Import Project="..\RizzyUI\build\RizzyUI.targets" Condition="Exists('..\RizzyUI\build\RizzyUI.targets')" />
</Project>