<Sidebar Collapsible="SidebarCollapsible.Icon">
    <SidebarHeader>
        <SidebarMenu>
            <SidebarMenuItem>
                <SidebarMenuButton Size="Size.Large" AsChild>
                    <a href="/">
                        <span class="bg-primary text-primary-foreground flex size-8 shrink-0 items-center justify-center rounded-lg">
                            <Blazicon Svg="Lucide.Sparkles" class="size-4" />
                        </span>
                        <span class="flex flex-col gap-0.5 leading-none">
                            <span class="font-semibold">RizzyUI.Starter</span>
                            <span class="text-muted-foreground text-xs">Built with RizzyUI</span>
                        </span>
                    </a>
                </SidebarMenuButton>
            </SidebarMenuItem>
        </SidebarMenu>
    </SidebarHeader>

    <SidebarContent>
        <SidebarGroup>
            <SidebarGroupLabel>Application</SidebarGroupLabel>
            <SidebarGroupContent>
                <SidebarMenu>
                    @foreach (var item in Items)
                    {
                        <SidebarMenuItem>
                            <SidebarMenuButton AsChild IsActive="@IsActive(item.Href)" Tooltip="@item.Title">
                                <a href="@item.Href" aria-current="@(IsActive(item.Href) ? "page" : null)">
                                    <Blazicon Svg="item.Icon" />
                                    <span>@item.Title</span>
                                </a>
                            </SidebarMenuButton>
                        </SidebarMenuItem>
                    }
                </SidebarMenu>
            </SidebarGroupContent>
        </SidebarGroup>
    </SidebarContent>

    <SidebarFooter>
        <SidebarMenu>
            <SidebarMenuItem>
                <SidebarMenuButton AsChild Tooltip="RizzyUI docs">
                    <a href="https://rizzyui.jalex.io" target="_blank" rel="noopener" hx-boost="false">
                        <Blazicon Svg="Lucide.BookOpen" />
                        <span>RizzyUI docs</span>
                    </a>
                </SidebarMenuButton>
            </SidebarMenuItem>
        </SidebarMenu>
    </SidebarFooter>

    <SidebarRail />
</Sidebar>

@code {
    private sealed record NavItem(string Title, string Href, SvgIcon Icon);

    private static readonly NavItem[] Items =
    [
        new("Dashboard", "/", Lucide.LayoutDashboard),
        new("Customers", "/customers", Lucide.Users),
        new("Settings", "/settings", Lucide.Settings),
    ];

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool IsActive(string href)
    {
        var path = HttpContext?.Request.Path.Value ?? "/";
        return href == "/"
            ? path == "/"
            : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
    }
}
