@inherits LayoutComponentBase

<RzSidebarProvider>
    <AppSidebar />

    <SidebarInset>
        <header class="bg-background/80 sticky top-0 z-40 flex h-14 shrink-0 items-center justify-between gap-2 border-b px-4 backdrop-blur">
            <div class="flex items-center gap-2">
                <SidebarTrigger />
                <RzSeparator Orientation="Orientation.Vertical" class="mr-2 h-6" />
                <span class="text-sm font-medium">RizzyUI.Starter</span>
            </div>
            <div class="flex items-center gap-2">
                <RzDarkModeToggle />
            </div>
        </header>

        <main id="content" class="flex flex-1 flex-col gap-6 p-4 md:p-6">
            @Body
        </main>
    </SidebarInset>
</RzSidebarProvider>
