<RzPageTitle>Customers</RzPageTitle>

<div class="flex flex-col gap-1">
    <h1 class="text-2xl font-semibold tracking-tight">Customers</h1>
    <p class="text-muted-foreground text-sm">
        Search and paging fetch only the table from <code>CustomersController.Table</code>, which returns a partial view.
    </p>
</div>

<RzCard>
    <CardHeader>
        <CardTitle>All customers</CardTitle>
        <CardDescription>@Result.TotalCount customers in the sample data.</CardDescription>
    </CardHeader>
    <CardContent class="flex flex-col gap-4">
        <div class="relative max-w-sm">
            <Blazicon Svg="Lucide.Search" class="text-muted-foreground pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2" />
            <input type="search"
                   name="q"
                   value="@Result.Query"
                   placeholder="Search by name, email or plan"
                   aria-label="Search customers"
                   autocomplete="off"
                   class="border-input bg-background focus-visible:ring-ring h-9 w-full rounded-md border pl-8 pr-3 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-2"
                   hx-get="/customers/table"
                   hx-trigger="input changed delay:300ms, search"
                   hx-target="#customer-table"
                   hx-swap="outerHTML" />
        </div>

        <CustomerTable Result="Result" />
    </CardContent>
</RzCard>

@code {
    [Parameter, EditorRequired]
    public CustomerPage Result { get; set; } = default!;
}
