<RzPageTitle>Something went wrong · Summit</RzPageTitle>

<div class="mx-auto max-w-xl px-4 py-24">
    <RzEmpty>
        <EmptyHeader>
            <EmptyMedia Variant="EmptyMediaVariant.Icon">
                <Blazicon Svg="Lucide.TriangleAlert" />
            </EmptyMedia>
            <EmptyTitle><h1>Something went wrong</h1></EmptyTitle>
            <EmptyDescription>
                The error has been logged. Please try again in a moment.
                @if (RequestId is not null)
                {
                    <span class="mt-2 block font-mono text-xs">Reference: @RequestId</span>
                }
            </EmptyDescription>
        </EmptyHeader>
        <EmptyContent>
            <RzButton Element="a" href="/" Variant="ThemeVariant.Primary">Back to the home page</RzButton>
        </EmptyContent>
    </RzEmpty>
</div>

@code {
    [Parameter] public string? RequestId { get; set; }
}
