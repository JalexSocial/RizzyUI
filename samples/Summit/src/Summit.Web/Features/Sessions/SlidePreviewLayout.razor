@inherits LayoutComponentBase
@inject IRizzyNonceProvider NonceProvider
@*
    The document inside RzBrowser's preview iframe (RzEmbeddedPreview renders it into srcdoc). It needs
    its own stylesheet and theme variables: nothing from the parent page reaches the iframe.
*@
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/@Assets["css/app.css"]" nonce="@NonceProvider.GetNonce()" />
    <RzHeadOutlet />
    <TrackStyles />
    <RzThemeProvider />
</head>
<body class="bg-background text-foreground antialiased">
    @Body
</body>
</html>
