@* The numbers strip on the home page. Served by /fragments/home/stats when it scrolls into view. *@
<dl id="home-stats" class="grid grid-cols-2 gap-6 sm:grid-cols-4">
    @Stat(Stats.Speakers, "speakers")
    @Stat(Stats.Sessions, "sessions")
    @Stat(Stats.Attendees, "attendees registered")
    @Stat(Stats.Countries, "countries")
</dl>

@code {
    public sealed record Numbers(int Speakers, int Sessions, int Attendees, int Countries);

    [Parameter, EditorRequired] public Numbers Stats { get; set; } = null!;

    private static RenderFragment Stat(int value, string label) =>
        @<div class="flex flex-col items-center gap-1 text-center">
            <dt class="text-muted-foreground order-2 text-sm">@label</dt>
            <dd class="order-1 text-4xl font-semibold tracking-tight tabular-nums sm:text-5xl">
                <RzNumberTicker Value="value" Culture="@CultureInfo.CurrentCulture.Name" />
            </dd>
        </div>;
}
