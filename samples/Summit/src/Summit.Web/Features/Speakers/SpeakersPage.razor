<RzPageTitle>Speakers · Summit</RzPageTitle>

<div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:px-6 sm:py-14">
    <PageHeader Title="Speakers" Eyebrow="Program"
                Description="Engineers, designers, researchers and maintainers. Search by name, company or role." />

    @* A GET form: the search box and pager fetch only the results. Without JavaScript it still works. *@
    <RzGetForm Model="_search" Action="/speakers" role="search" class="max-w-xl">
        <label for="speaker-query" class="sr-only">Search speakers</label>
            <RzInputGroup>
                <InputGroupAddon><Blazicon Svg="Lucide.Search" class="size-4" /></InputGroupAddon>
                <InputGroupInput id="speaker-query" For="@(() => _search.Q)" name="q" type="search" placeholder="Search by name, company or role" autocomplete="off"
                                 hx-get="/speakers" hx-trigger="input changed delay:300ms, search" hx-target="#speaker-results" hx-swap="outerHTML"
                                 hx-indicator="#speaker-loading" />
                <InputGroupAddon Align="InputGroupAddonAlign.InlineEnd">
                    <RzSpinner Id="speaker-loading" Size="Size.Small" AriaLabel="Searching" class="htmx-indicator" />
                </InputGroupAddon>
            </RzInputGroup>
    </RzGetForm>

    <SpeakerCount Result="Result" />
    <SpeakerResults Result="Result" />
</div>

@code {
    [Parameter, EditorRequired] public SpeakerSearch Result { get; set; } = null!;

    private sealed class SearchModel { public string Q { get; set; } = ""; }

    private SearchModel _search = new();

    protected override void OnParametersSet() => _search = new SearchModel { Q = Result.Query };
}
