@inherits LayoutComponentBase


@* RzSidebarProvider reads its own cookie on the server, so a collapsed sidebar renders collapsed. *@
<RzSidebarProvider Collapsible="SidebarCollapsible.Icon">
    <OrganizerSidebar />

    <SidebarInset>
        <header class="bg-background/80 sticky top-0 z-30 flex h-14 shrink-0 items-center gap-2 border-b px-3 backdrop-blur sm:px-4">
            <SidebarTrigger />
            <RzSeparator Orientation="Orientation.Vertical" class="mx-1 h-5" />
            <OrganizerBreadcrumb />
            <div class="ml-auto flex items-center gap-1.5">
                <OrganizerQuickActions />
                <CultureSwitch />
                <RzDarkModeToggle />
            </div>
        </header>

        <main id="content" tabindex="-1" class="flex flex-1 flex-col gap-6 p-4 outline-none md:p-6">
            @Body
        </main>
    </SidebarInset>
</RzSidebarProvider>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
}
