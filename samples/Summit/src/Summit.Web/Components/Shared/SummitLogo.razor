@* The Summit wordmark: a stylized peak with an aurora ribbon. Decorative inside links that carry their own name. *@
<span class="@($"inline-flex items-center gap-2 {Class}")">
    <svg viewBox="0 0 32 32" class="size-8 shrink-0" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="@_gradientId" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#6d5efc" />
                <stop offset="0.55" stop-color="#a855f7" />
                <stop offset="1" stop-color="#14b8a6" />
            </linearGradient>
        </defs>
        <rect width="32" height="32" rx="9" fill="@($"url(#{_gradientId})")" />
        <path d="M6 23 L13.5 11 L17.5 17 L20 13.5 L26 23 Z" fill="white" fill-opacity="0.95" />
        <path d="M13.5 11 L15.6 14.2 L13.9 13.3 L12.2 14.6 Z" fill="#6d5efc" fill-opacity="0.35" />
    </svg>
    @if (!IconOnly)
    {
        <span class="text-lg font-semibold tracking-tight">Summit</span>
    }
</span>

@code {
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public string? Class { get; set; }

    // Each logo on the page needs its own gradient id.
    private readonly string _gradientId = "summit-logo-" + Guid.NewGuid().ToString("N")[..8];
}
