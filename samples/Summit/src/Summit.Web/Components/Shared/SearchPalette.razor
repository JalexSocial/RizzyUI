@*
    The site-wide search palette (Ctrl+K / Cmd+K, or the search button in the header): RzCommandDialog
    with items from /api/search, filtered on the server. Each item's href is the page it opens.
*@
<RzCommandDialog EventTriggerName="summit:open-search" Shortcut="k" Title="Search Summit" Description="Search sessions, speakers and pages."
                 ItemsUrl="/api/search" ServerFiltering="true" FetchTrigger="FetchTrigger.OnOpen" ShouldFilter="false">
    <CommandInput Placeholder="Search sessions, speakers and pages…" />
    <CommandList class="max-h-[60vh]">
        <CommandEmpty>No results. Try a track, a speaker's name or a topic like “htmx”.</CommandEmpty>
        <CommandItemTemplate>
            <span class="flex min-w-0 flex-col gap-0.5">
                <span class="truncate text-sm font-medium" x-text="item.name"></span>
                <span class="text-muted-foreground truncate text-xs" x-text="item.description"></span>
            </span>
            <span class="text-muted-foreground ml-auto shrink-0 pl-3 text-xs" x-text="item.group"></span>
        </CommandItemTemplate>
    </CommandList>
</RzCommandDialog>
