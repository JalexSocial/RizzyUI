@using System.Globalization
@inject Microsoft.Extensions.Options.IOptions<SummitOptions> Options
@*
    The live counter. It polls (every Summit:CheckIn:PollSeconds) so a desk sees check-ins from other
    desks, and is also replaced out of band after a check-in here. hx-sync drops a poll that would
    overlap the previous one. The numbers are not a live region: a poll every few seconds must not be
    announced. The live dot gets role="img": RzIndicator puts aria-label on a div without a role
    (SF-066).
*@
<RzCard id="checkin-counter" hx-get="/organizer/check-in/counter" hx-trigger="@($"every {Options.Value.CheckIn.PollSeconds}s")"
        hx-swap="outerHTML" hx-sync="this:drop">
    <CardHeader>
        <CardTitle class="flex items-center gap-2">
            <span class="relative inline-flex size-2.5"><RzIndicator Color="Colors.Emerald.L500" Size="Size.Small" Position="IndicatorPosition.Center" class="animate-pulse" role="img" AriaLabel="Live" /></span>
            Checked in
        </CardTitle>
        <CardDescription>Updates every @Options.Value.CheckIn.PollSeconds seconds</CardDescription>
    </CardHeader>
    <CardContent class="flex flex-col gap-3">
        <p class="text-4xl font-semibold tabular-nums" data-checked-in="@Count.CheckedIn">
            @Count.CheckedIn.ToString("N0", CultureInfo.CurrentCulture)
            <span class="text-muted-foreground text-base font-normal">of @Count.Expected.ToString("N0", CultureInfo.CurrentCulture)</span>
        </p>
        <RzProgress Value="@(Count.Expected == 0 ? 0 : Count.CheckedIn * 100.0 / Count.Expected)" AriaLabel="Attendees checked in"
                    ValueText="@($"{Count.CheckedIn} of {Count.Expected} attendees checked in")" />
    </CardContent>
</RzCard>

@code {
    [Parameter, EditorRequired] public CheckInCount Count { get; set; } = null!;
}
