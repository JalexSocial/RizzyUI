@*
    Organizer › Check-in desk, designed for a phone at the door: the badge form first, then the live
    counter, then the latest check-ins.
*@
<RzPageTitle>Check-in desk · Summit organizer</RzPageTitle>

<PageHeader Title="Check-in desk" Description="Type or scan the six characters on a badge." />

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)]">
    <div class="flex flex-col gap-6">
        <CheckInForm />
        <CheckInCounter Count="Count" />
    </div>
    <RecentCheckIns Rows="Recent" />
</div>

@code {
    [Parameter, EditorRequired] public CheckInCount Count { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<RecentCheckIn> Recent { get; set; } = [];
}
