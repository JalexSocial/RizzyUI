@* The editor when no session is open. *@
<RzCard id="session-editor">
    <CardContent class="pt-6">
        <RzEmpty>
            <EmptyHeader>
                <EmptyMedia Variant="EmptyMediaVariant.Icon"><Blazicon Svg="Lucide.CalendarClock" /></EmptyMedia>
                <EmptyTitle>No session open</EmptyTitle>
                <EmptyDescription>Choose a session from the list, or create one from the File menu.</EmptyDescription>
            </EmptyHeader>
        </RzEmpty>
    </CardContent>
</RzCard>
