@*
    The attendee editor: an RzSheet that is open as soon as it is swapped into #attendee-editor (content
    loaded on demand renders open), and closed by the server after a save with
    HX-Trigger: {"rz:sheet-close": {"id": "attendee-sheet"}} (D-29).
*@
<RzSheet Id="@SheetId" DefaultOpen="true">
    <SheetContent Side="SheetSide.Right" class="w-full overflow-y-auto sm:max-w-md">
        <SheetHeader>
            <SheetTitle>Edit attendee</SheetTitle>
            <SheetDescription>Changes are saved to the registration and logged in the audit trail.</SheetDescription>
        </SheetHeader>
        <div class="px-4 pb-6">
            <AttendeeEditForm AttendeeId="AttendeeId" Initial="Initial" TicketTypes="TicketTypes" />
        </div>
    </SheetContent>
</RzSheet>

@code {
    public const string SheetId = "attendee-sheet";

    [Parameter, EditorRequired] public int AttendeeId { get; set; }
    [Parameter] public AttendeeEditModel? Initial { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<TicketType> TicketTypes { get; set; } = [];
}
