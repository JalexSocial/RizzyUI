@using Microsoft.AspNetCore.Components.Routing
@inject Rizzy.Htmx.IRizzyNonceProvider NonceProvider

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RizzyUI consumer smoke test</title>

    @* Rizzy 6: the htmx-config meta tag first, then htmx, rizzy.js and its extensions. *@
    <RzHeadOutlet />
    <RzScripts />

    @* RizzyUI (CSP build, from the package's static web assets) after Rizzy. *@
    <script type="module" nonce="@NonceProvider.GetNonce()" src="/_content/RizzyUI/js/rizzyui-csp.min.js"></script>
</head>
<body>
    <RzThemeProvider>
        <Router AppAssembly="typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="routeData" />
            </Found>
        </Router>
    </RzThemeProvider>
</body>
</html>
