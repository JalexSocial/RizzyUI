<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Minimal SSR consumer used by eng/consumer-smoke-test.sh. It references the RizzyUI package
    produced by `dotnet pack` (never the project), so the test validates the package contents:
    the library, its static web assets (_content/RizzyUI) and its Rizzy 6 dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RizzyUI" Version="$(RizzyUIVersion)" />
  </ItemGroup>

</Project>
