# The client bundles' source maps embed the source text, and CI checks the committed bundles
# against a fresh build on Linux. Check the client sources out with LF on every OS so a build on
# Windows (core.autocrlf=true) produces the same maps.
packages/rizzyui/src/** text eol=lf
packages/rizzyui/dist/** -text
src/RizzyUI/wwwroot/js/** -text

# Written by the docs build (Tailwind) and the accessibility pretest (copied from node_modules).
# Byte-for-byte on every OS, so building and testing leave `git status` clean on Windows too.
src/RizzyUI.Docs/wwwroot/css/app.css -text
src/RizzyUI.Docs/wwwroot/vendor/** -text
